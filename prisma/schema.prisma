generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum SystemRole {
  ADMIN
  FINANCE
  SALES
  PM
  EMPLOYEE
  CONTRACTOR
  // External customer portal user — belongs to a Client (via User.clientId), authenticates with a
  // password (always, even when staff password login is disabled), and is confined to /portal where
  // they only ever see and act on their own client's tickets. Never granted internal `can(...)` rights.
  CUSTOMER
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectBillingType {
  TIME_AND_MATERIALS
  FIXED_PRICE
  RETAINER
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETE
  INVOICED
}

enum AssignmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TimeCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Register/reconciliation lifecycle: recorded (DRAFT) -> finalized & revenue recognized (ISSUED)
// -> matched to the fiscal app + customer document (RECONCILED) -> settled (PAID). VOID cancels.
enum InvoiceStatus {
  DRAFT
  ISSUED
  RECONCILED
  PAID
  VOID
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Sales pipeline position for an Opportunity. The open stages (QUALIFYING -> PROPOSAL_SENT ->
// NEGOTIATION) are freely moved by anyone with opportunities:manage. PENDING_APPROVAL is the
// deal-desk gate: a manager submits, and only an Admin (opportunities:approve) can move it to
// WON (which auto-creates the Project + Milestones) or bounce it back to NEGOTIATION. LOST /
// CANCELLED are terminal.
enum OpportunityStage {
  QUALIFYING
  PROPOSAL_SENT
  NEGOTIATION
  PENDING_APPROVAL
  WON
  LOST
  CANCELLED
}

// How a discount is expressed: PERCENT (discountValue is a 0-100 percentage of the list total)
// or ABSOLUTE (discountValue is a fixed money amount in the deal currency).
enum DiscountType {
  PERCENT
  ABSOLUTE
}

// ---------- Core / Foundation ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  taxCategories     TaxCategory[]
  taxPayments       TaxPayment[]
  vendors           Vendor[]
  vendorPayments    VendorPayment[]
  opportunities     Opportunity[]
  documents         Document[]
  statusReports     StatusReport[]
  sopGuides         SopGuide[]
  raidItems         RaidItem[]
  meetings          MeetingMinutes[]
  planTasks         PlanTask[]
  cutoverPlans      CutoverPlan[]
  cutoverTasks      CutoverTask[]
  cutoverLists      CutoverList[]
  uatScripts        UatScript[]
  uatAreas          UatArea[]
  uatTestCases      UatTestCase[]
  uatIssues         UatIssue[]
  tickets           Ticket[]
  ticketTypes       TicketTypeDef[]
  ticketStatuses    TicketStatusDef[]
  ticketFields      TicketFieldDef[]
  ticketViews       TicketView[]
  slaPolicies       SlaPolicy[]
  engagements       Engagement[]
  skills            Skill[]
  milestoneAdjustments MilestoneAdjustment[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  email        String     @unique
  passwordHash String
  name         String
  role         SystemRole @default(EMPLOYEE)
  active       Boolean    @default(true)
  // Set only for CUSTOMER (portal) users — the Client they belong to. Null for all internal staff.
  clientId     String?
  client       Client?    @relation("ClientPortalUsers", fields: [clientId], references: [id])
  // Self-service profile fields — editable by the person themselves on /profile (never email,
  // password, or role). `avatarUrl` stores just the on-disk file name (served, authenticated,
  // through /api/avatars/[fileName]); everything else is free text.
  title        String?
  phone        String?
  location     String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employment            Employment?
  salaries              Salary[]
  projectsManaged       Project[]              @relation("ProjectManager")
  projectsUatRecorded   Project[]              @relation("ProjectUatRecordedBy")
  projectUatEvents      ProjectUatEvent[]      @relation("ProjectUatEventActor")
  assignments           Assignment[]
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  timeEntries           TimeEntry[]
  timeCards             TimeCard[]
  timeCardApprovals     TimeCard[]             @relation("TimeCardApprover")
  timeCardSubmissions   TimeCard[]             @relation("TimeCardSubmitter")
  milestoneReallocations MilestoneReallocation[]
  leaveRequests        LeaveRequest[] @relation("LeaveOwner")
  leaveRequestsMade    LeaveRequest[] @relation("LeaveRequestedBy")
  leaveRequestsDecided LeaveRequest[] @relation("LeaveDecidedBy")
  leaveReturnsRecorded LeaveReturn[]
  expensesOwned        Expense[] @relation("ExpenseOwner")
  expensesSubmitted    Expense[] @relation("ExpenseSubmittedBy")
  expensesDecided      Expense[] @relation("ExpenseDecidedBy")
  taxPaymentsRecorded  TaxPayment[] @relation("TaxPaymentRecordedBy")
  vendorPaymentsRecorded VendorPayment[] @relation("VendorPaymentRecordedBy")
  opportunitiesOwned     Opportunity[] @relation("OpportunityOwner")
  opportunitiesSubmitted Opportunity[] @relation("OpportunitySubmittedBy")
  opportunitiesDecided   Opportunity[] @relation("OpportunityDecidedBy")
  opportunityRevisions   OpportunityRevision[] @relation("OpportunityRevisionIssuedBy")
  opportunityAmendments  OpportunityAmendment[] @relation("OpportunityAmendmentAppliedBy")
  documents              Document[]
  statusReportsAuthored  StatusReport[]         @relation("StatusReportAuthor")
  raidCreated            RaidItem[]             @relation("RaidCreatedBy")
  meetingsCreated        MeetingMinutes[]       @relation("MinutesCreatedBy")
  milestoneAdjustments   MilestoneAdjustment[]  @relation("MilestoneAdjustmentBy")
  ticketsRequested       Ticket[]               @relation("TicketRequester")
  ticketsAssigned        Ticket[]               @relation("TicketAssignee")
  ticketsCreated         Ticket[]               @relation("TicketCreatedBy")
  ticketComments         TicketComment[]
  ticketWorklogs         TicketWorklog[]
  ticketAttachments      TicketAttachment[]
  ticketViews            TicketView[]
  ticketNotifications    TicketNotification[]

  @@index([companyId])
  @@index([clientId])
  clientTeams        ClientTeamMember[] @relation("ClientTeamMemberUser")
  engagementMemberships EngagementMember[]
  skills             UserSkill[]
  certifications     Certification[]
  clientTeamsCreated ClientTeamMember[] @relation("ClientTeamMemberCreatedBy")
}

/** Per-user salary history: cost rate is derived from this, never entered directly. Multiple
 *  rows let a promotion/raise take effect on a specific date without losing the prior rate's
 *  history (used when computing historically-accurate cost basis). */
model Salary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  monthlyAmount Decimal  @db.Decimal(12, 2)
  currency      String // "ALL" or "EUR" — some contractors are paid directly in EUR
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, effectiveFrom])
}

/** Historical currency conversion rates (e.g. ALL->EUR), quoted as "how many `fromCurrency`
 *  units equal 1 `toCurrency` unit" (e.g. rate 105.5 means 105.5 ALL = 1 EUR). */
model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(14, 6)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveFrom])
  @@index([fromCurrency, toCurrency, effectiveFrom])
}

model Employment {
  id         String         @id @default(cuid())
  userId     String         @unique
  user       User           @relation(fields: [userId], references: [id])
  type       EmploymentType @default(EMPLOYEE)
  costRate   Decimal        @db.Decimal(10, 4)
  startDate  DateTime
  endDate    DateTime?
  // Manual opening vacation balance, for teams onboarded onto the app mid-life (no historical
  // LeaveRequests to derive carryover from). When both are set, computeVacationBalance seeds its
  // year-walk with `carriedInVacationDays` as the balance at Jan 1 of `carriedInVacationYear`
  // and grants full annual entitlement from that year on, instead of summing from the hire date.
  carriedInVacationDays Decimal?  @db.Decimal(5, 2)
  carriedInVacationYear Int?
  // Contracted hours per full working week. Drives planner capacity: a day is worth
  // weeklyCapacityHours / 5, so part-timers and contractors are modelled honestly instead of
  // everyone being assumed to be a 40h employee.
  weeklyCapacityHours Decimal @db.Decimal(5, 2) @default(40)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ---------- Clients ----------

model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  // Standard payment terms in days (e.g. 30 = net 30). Defaults an invoice's due date at creation,
  // and back-fills the AR aging date for invoices that have no due date of their own. Null = no
  // agreed terms; such invoices are aged into a "No due date" bucket rather than guessed.
  paymentTermsDays Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  projects Project[]
  invoices Invoice[]
  opportunities Opportunity[]
  tickets  Ticket[]
  portalUsers User[]  @relation("ClientPortalUsers")
  slaPolicies SlaPolicy[]

  @@index([companyId])
  teamMembers ClientTeamMember[]
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([clientId])
}

// ---------- Projects / Milestones / Assignments ----------

model Project {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id])
  name         String
  // Auto-assigned internal project number, e.g. PR-0000001 (unique per company).
  number       String?
  // Program hierarchy: a project can be a "program" (e.g. the Tungsten engagement) containing
  // sub-projects, one per end customer (Zambon, Bonfiglioli, Q8). Direct clients leave this null.
  parentProjectId String?
  parent          Project?  @relation("ProjectProgram", fields: [parentProjectId], references: [id])
  children        Project[] @relation("ProjectProgram")
  // The end customer this stream delivers to (only meaningful for a sub-project under a program).
  endCustomer     String?
  status       ProjectStatus      @default(PLANNED)
  billingType  ProjectBillingType @default(TIME_AND_MATERIALS)
  startDate    DateTime?
  endDate      DateTime?
  budgetAmount Decimal?           @db.Decimal(12, 2)
  budgetHours  Decimal?           @db.Decimal(8, 2)
  managerId    String?
  manager      User?              @relation("ProjectManager", fields: [managerId], references: [id])
  // Flags a project as company-internal (not billed to a real client) — e.g. an umbrella
  // project for vacation tracking. Still requires a Client like any project (create a
  // placeholder one); this flag just filters it into pickers like the vacation-approval
  // project selector instead of any structural difference.
  isInternal   Boolean            @default(false)
  // Contract terms carried over when a Project is created from a won Opportunity. Milestones keep
  // the list sales price; the negotiated discount lives here (type + value) alongside the resulting
  // net `contractValue`, so the discount is always visible on the project without re-pricing every
  // milestone. `sowNumber`/`poNumber` mirror the SoW/PO captured on the opportunity (poNumber also
  // feeds invoice defaults). All nullable — a hand-created project (no opportunity) simply leaves
  // them unset.
  discountType   DiscountType?
  discountValue  Decimal?           @db.Decimal(12, 2)
  contractValue  Decimal?           @db.Decimal(12, 2)
  sowNumber      String?
  poNumber       String?
  // UAT / customer acceptance — a small workflow: NOT_STARTED → SENT (for signature) → ACCEPTED
  // (customer replied with the signed document), with CHANGES_REQUESTED for a bounce-back. Each
  // transition is logged in ProjectUatEvent (the history). `uatAccepted` mirrors status == ACCEPTED
  // so the soft invoice-time warning and badge keep working. The signed document attaches via a
  // Document row with kind UAT_ACCEPTANCE + projectId.
  uatStatus       ProjectUatStatus @default(NOT_STARTED)
  uatAccepted     Boolean   @default(false)
  uatAcceptedDate DateTime? // the date the customer signed off
  uatSignatory    String? // name (and optionally role) of the client-side signatory
  uatNotes        String? // note captured with the acceptance
  // Test-script preparation (distinct from acceptance): the consultant prepares it and sends it to
  // the customer before UAT; the PM governs that it's actually ready/sent.
  uatRecordedById String? // internal user who recorded the acceptance
  uatRecordedBy   User?     @relation("ProjectUatRecordedBy", fields: [uatRecordedById], references: [id])
  uatRecordedAt   DateTime? // when it was recorded in the app
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  milestones Milestone[]
  opportunity Opportunity? @relation("OpportunityProject")
  amendments  OpportunityAmendment[]
  invoices    Invoice[]
  documents   Document[]
  vendorPayments VendorPayment[]
  uatEvents   ProjectUatEvent[]
  statusReports  StatusReport[]
  raidItems      RaidItem[]
  meetings       MeetingMinutes[]
  planTasks      PlanTask[]
  cutoverPlans   CutoverPlan[]
  cutoverTasks   CutoverTask[]
  cutoverLists   CutoverList[]
  uatScripts     UatScript[]
  uatAreas       UatArea[]
  uatTestCases   UatTestCase[]
  uatIssues      UatIssue[]
  tickets        Ticket[]
  engagements    Engagement[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([parentProjectId])
}

// The UAT / customer-acceptance workflow phases for a project.
enum ProjectUatStatus {
  NOT_STARTED
  SENT // sent to the customer for signature
  ACCEPTED // customer replied with the signed acceptance
  CHANGES_REQUESTED // customer bounced it back / asked for changes
}

// One entry in a project's UAT history — a transition to `status`, who did it and when, plus a note.
model ProjectUatEvent {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ProjectUatStatus
  note      String?
  actorId   String
  actor     User             @relation("ProjectUatEventActor", fields: [actorId], references: [id])
  createdAt DateTime         @default(now())

  @@index([projectId])
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  name          String
  description   String?
  billable      Boolean         @default(true)
  salesPrice    Decimal         @db.Decimal(12, 4)
  cost          Decimal         @db.Decimal(12, 2)
  budgetHours   Decimal?        @db.Decimal(8, 2)
  startDate     DateTime?
  endDate       DateTime?
  timeEntryOpen Boolean         @default(true)
  status        MilestoneStatus @default(PLANNED)
  // Set when the milestone is marked COMPLETE — records who/when and a note. Completing locks time
  // entry (timeEntryOpen=false) and recognizes the milestone's full value (see revenue).
  completedAt   DateTime?
  completionNote String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assignments      Assignment[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  timeCards        TimeCard[]
  invoiceLines     InvoiceLine[]
  reallocationsFrom MilestoneReallocation[] @relation("ReallocFrom")
  reallocationsTo   MilestoneReallocation[] @relation("ReallocTo")
  leaveRequests     LeaveRequest[]
  adjustments       MilestoneAdjustment[]

  @@index([projectId])
  vendorPayments VendorPayment[]
}

// An adjustment to a milestone's value — e.g. the customer will self-manage part, or an amount is
// moved to a new PO/CR. Signed (negative removes, positive absorbs). Keeps an audit trail so the
// project's remaining budget is always clear; optionally links to the opportunity it moved to.
model MilestoneAdjustment {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  milestoneId   String
  milestone     Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  createdById   String
  createdBy     User         @relation("MilestoneAdjustmentBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([milestoneId])
  @@index([companyId])
}

model Assignment {
  id             String           @id @default(cuid())
  milestoneId    String
  milestone      Milestone        @relation(fields: [milestoneId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  costRate       Decimal          @db.Decimal(10, 4)
  // Sell (bill) rate snapshot, taken from the milestone's salesPrice at assignment creation for
  // T&M / RETAINER projects (an hourly rate). Null for FIXED_PRICE (no per-hour sell rate) and for
  // legacy assignments. Editable by rates:view:any on the assignment form.
  billRate       Decimal?         @db.Decimal(10, 4)
  allocatedHours Decimal?         @db.Decimal(8, 2)
  startDate      DateTime
  endDate        DateTime
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  timeEntries TimeEntry[]
  timeCards   TimeCard[]
  planEntries AssignmentPlan[]
  leaveRequests LeaveRequest[]

  @@unique([milestoneId, userId])
}

// A planned-hours cell. `taskId` NULL = assignment-level plan (one number for the whole
// assignment that week); `taskId` set = a task-level breakdown row. Invariant (enforced by the
// NULLS NOT DISTINCT unique index): for any (assignment, week) there is EITHER one assignment-level
// row OR one-or-more task-level rows, never both — so summing `hours` by assignment always gives
// the correct weekly total with no double counting.
model AssignmentPlan {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  hours         Decimal    @db.Decimal(6, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assignmentId, taskId, weekStartDate])
  @@index([weekStartDate])
  @@index([taskId])
}

model Task {
  id             String     @id @default(cuid())
  milestoneId    String
  milestone      Milestone  @relation(fields: [milestoneId], references: [id])
  name           String
  description    String?
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  estimatedHours Decimal?   @db.Decimal(8, 2)
  startDate      DateTime?
  dueDate        DateTime?
  status         TaskStatus @default(TODO)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  timeEntries     TimeEntry[]
  assignmentPlans AssignmentPlan[]

  @@index([milestoneId])
}

// ---------- Time tracking & approvals ----------

// One TimeCard is one "line" in the weekly time grid: a single assignment for a single week,
// with its own independent lifecycle (DRAFT -> SUBMITTED -> APPROVED/REJECTED). It can span
// several tasks under that assignment (each task is just a row of hours within the same card —
// tasks don't carry their own status and don't feed invoicing on their own, only the
// assignment/milestone does). A person can have several TimeCards open in the same week across
// different projects, each decided independently by that project's manager — and can add a
// brand-new TimeCard for the same assignment/week as a correction line once an earlier one is
// APPROVED (those are frozen).
model TimeCard {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  assignmentId  String
  assignment    Assignment     @relation(fields: [assignmentId], references: [id])
  milestoneId   String
  milestone     Milestone      @relation(fields: [milestoneId], references: [id])
  weekStartDate DateTime
  status        TimeCardStatus @default(DRAFT)
  submittedAt   DateTime?
  // Who actually clicked Submit — distinct from `user` (whose time this is): a PM/Admin
  // proxy-submitting on someone else's behalf means these two differ.
  submittedById String?
  submittedBy   User?          @relation("TimeCardSubmitter", fields: [submittedById], references: [id])
  approverId    String?
  approver      User?          @relation("TimeCardApprover", fields: [approverId], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  entries TimeEntry[]

  @@index([userId, weekStartDate])
  @@index([assignmentId])
  @@index([approverId, status])
}

model TimeEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  assignmentId  String
  assignment    Assignment   @relation(fields: [assignmentId], references: [id])
  milestoneId   String
  milestone     Milestone    @relation(fields: [milestoneId], references: [id])
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  timeCardId    String
  timeCard      TimeCard     @relation(fields: [timeCardId], references: [id])
  date          DateTime
  hours         Decimal      @db.Decimal(5, 2)
  // Historical cost rate (EUR/h) frozen onto the entry when its card is APPROVED — the rate that
  // was correct on `date` (salary + FX effective then). Null until approved / for legacy rows;
  // cost math falls back to the assignment's snapshot rate when null. See src/lib/cost-rate.ts.
  costRate      Decimal?     @db.Decimal(10, 4)
  // Historical bill rate (sell rate/h) frozen onto the entry when its card is APPROVED, mirroring
  // costRate — the effective rate on `date`. Null until approved / for legacy rows; realization math
  // falls back to the assignment's billRate snapshot when null. See src/lib/cost-rate.ts.
  billRate      Decimal?     @db.Decimal(10, 4)
  description   String?
  invoiceLineId String?
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([timeCardId, taskId, date])
  @@index([userId, date])
  @@index([assignmentId])
  @@index([milestoneId, date])
  @@index([timeCardId])
}

// ---------- Leave (vacation, sick, parental) ----------

enum LeaveType {
  VACATION
  SICK
  PATERNITY
  MATERNITY
}

// A request for time off, of any LeaveType. `workingDays` is computed at request time (working
// days in the range, excluding weekends and Albanian public holidays). Only VACATION has an
// annual entitlement/balance (see computeVacationBalance) — SICK is uncapped/just tracked, and
// PATERNITY/MATERNITY are one-time per-event periods with no preset duration, both without any
// balance math. Admin-created requests are auto-approved for every type (no separate decision
// step) — `requestedById` still distinguishes "who filed this" from `userId` ("whose leave it
// is"), same pattern as TimeCard.submittedById.
// On approval, `milestoneId`/`assignmentId` point at the auto-created (or reused) non-billable
// milestone + assignment (named per type, e.g. "Sick Leave") under whichever internal project
// the approver chose — see src/lib/vacation.ts#provisionLeave for how those get created and how
// the days get mirrored into AssignmentPlan and pre-approved TimeCards.
model LeaveRequest {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation("LeaveOwner", fields: [userId], references: [id])
  type          LeaveType      @default(VACATION)
  startDate     DateTime
  endDate       DateTime
  workingDays   Decimal        @db.Decimal(5, 2)
  status        VacationStatus @default(PENDING)
  reason        String?
  requestedById String
  requestedBy   User           @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  milestoneId   String?
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id])
  assignmentId  String?
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  returns LeaveReturn[]

  @@index([userId, startDate])
  @@index([status])
  @@index([type])
}

// Records an early/partial return to work *within* an already-APPROVED LeaveRequest's date
// range — e.g. someone comes back a week early from vacation and stays, or comes back for a
// couple of days mid-sick-leave and then goes back out. A single LeaveRequest can have several
// of these (handles the intermittent case, not just a single early end), each independently
// validated to fall inside the request's range and not overlap another return. Recording one
// un-provisions those specific days (see src/lib/vacation.ts#recordLeaveReturn): removes the
// matching TimeEntry rows, decrements the affected AssignmentPlan weeks, and decrements the
// parent LeaveRequest.workingDays — which is what actually gives the days back to
// computeVacationBalance for VACATION (SICK/PATERNITY/MATERNITY have no balance to give back to,
// but still get the same un-provisioning).
model LeaveReturn {
  id             String       @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  startDate      DateTime
  endDate        DateTime
  workingDays    Decimal      @db.Decimal(5, 2)
  recordedById   String
  recordedBy     User         @relation(fields: [recordedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([leaveRequestId])
}

// ---------- Milestone reallocation ----------

model MilestoneReallocation {
  id             String    @id @default(cuid())
  fromMilestoneId String
  fromMilestone  Milestone @relation("ReallocFrom", fields: [fromMilestoneId], references: [id])
  toMilestoneId  String
  toMilestone    Milestone @relation("ReallocTo", fields: [toMilestoneId], references: [id])
  hours          Decimal   @db.Decimal(8, 2)
  hoursReceived  Decimal   @db.Decimal(8, 2)
  costMoved      Decimal   @db.Decimal(12, 2)
  byUserId       String
  byUser         User      @relation(fields: [byUserId], references: [id])
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([fromMilestoneId])
  @@index([toMilestoneId])
}

// ---------- Invoicing ----------

// An entry in the invoice REGISTER — RM Ops does not generate fiscal documents (the external
// fiscal app does); this records what was billed against a project, ties it to the fiscal app's
// number and the customer's document, tracks revenue recognition, and reconciles the two.
model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  // What this invoice bills. Optional so a client-level or ad-hoc entry is still possible.
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  // Our internal register number (e.g. INV-0001) — always ours, distinct from the fiscal number.
  invoiceNumber   String
  type            InvoiceType   @default(INVOICE)
  status          InvoiceStatus @default(DRAFT)
  // German self-billing (Gutschrift): the customer issued a credit note and we record a matching
  // invoice for revenue recognition only — never sent to them.
  selfBilled      Boolean       @default(false)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  // Revenue-recognition date for month-end cutoff (falls back to issueDate when null).
  recognitionDate DateTime?
  // Service period — only meaningful for time-based invoices, hence optional.
  periodStart     DateTime?
  periodEnd       DateTime?
  currency        String        @default("USD")
  // VAT percentage; net comes from the lines, gross = net + net*vatRate. The fiscal app is the
  // source of truth for tax — this is captured for management totals only.
  vatRate         Decimal?      @db.Decimal(5, 2)
  // Optional sales-commission discount, expressed as a percentage of the invoice's line net
  // and/or a flat amount (they combine: discount = net*commissionPercent/100 + commissionFixed).
  // The resulting figure is materialised as the negative "Sales comision" line; these two fields
  // remember how it was entered so it round-trips on edit and % recomputes if the lines change.
  commissionPercent Decimal?    @db.Decimal(5, 2)
  commissionFixed   Decimal?    @db.Decimal(12, 2)
  // Reconciliation references.
  fiscalNumber    String? // the external fiscal app's invoice number
  fiscalReference String? // any extra fiscal-side reference
  customerReference String? // customer PO / credit-note number / their document ref
  poNumber        String?
  referenceNumber String?
  issuedAt        DateTime?
  reconciledAt    DateTime?
  notes           String?
  // A credit note can point at the original invoice it adjusts.
  creditNoteForId String?
  creditNoteFor   Invoice?      @relation("InvoiceCreditNotes", fields: [creditNoteForId], references: [id])
  creditNotes     Invoice[]     @relation("InvoiceCreditNotes")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines     InvoiceLine[]
  payments  InvoicePayment[]
  documents Document[]

  @@unique([companyId, invoiceNumber])
  @@index([clientId])
  @@index([projectId])
  @@index([companyId, status])
}

// A partial (or full) payment recorded against an invoice. Outstanding = gross − Σ payments.
model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  // Cash that actually landed in our account.
  amount    Decimal  @db.Decimal(12, 2)
  // Charges the bank withheld in transit (transfer/intermediary fees). The customer parted with
  // `amount + bankFee`, so that sum is what settles the invoice — otherwise a fully-paid invoice
  // would sit forever showing a few euros outstanding.
  bankFee   Decimal  @db.Decimal(12, 2) @default(0)
  date      DateTime
  method    String?
  reference String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  description String
  quantity    Decimal    @db.Decimal(8, 2)
  rate        Decimal    @db.Decimal(10, 4)
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  timeEntries TimeEntry[]

  @@index([invoiceId])
  @@index([milestoneId])
}

// ---------- Expenses ----------

enum ExpensePaidBy {
  COMPANY  // paid directly from company funds (bank transfer, cash, company card) — nobody is owed money back
  EMPLOYEE // the user paid personally and is owed reimbursement
}

enum ExpenseStatus {
  DRAFT // captured via the /capture PWA, not yet confirmed — excluded from approvals + reports
  PENDING
  APPROVED
  REJECTED
}

// How an expense record was created: MANUAL (the /expenses form) or CAPTURE (the /capture PWA
// receipt-scan flow, which pre-fills fields from Azure Document Intelligence).
enum ExpenseSource {
  MANUAL
  CAPTURE
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

// Admin/Finance-managed list of spending types (Utilities, Travel, ...) — kept editable rather
// than a fixed enum since the user was explicit this list isn't exhaustive ("and other stuff").
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

// A single expense line — the primary record accountants reconcile against bank statements at
// year-end, hence the emphasis on always capturing date/amount/description even when there's no
// receipt (e.g. a cash-paid recurring fee with no invoice issued, a real problem the user
// flagged specifically). `userId` is whose expense this is (for EMPLOYEE: who gets reimbursed;
// for COMPANY: who handled/paid it, e.g. with the company card) — distinct from `submittedById`
// (who actually filed the record), same "owner vs actor" pattern used by TimeCard/LeaveRequest.
// Auto-approval: whenever `submittedBy` has `expenses:manage` (Admin/Finance), the record lands
// already APPROVED regardless of paidBy — anyone else's entry (of either paidBy type) goes to
// PENDING for review, since the point of approval here isn't just authorizing a reimbursement
// payout, it's confirming the record is accurate/correctly categorized before it hits the books.
model Expense {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id])
  categoryId    String
  category      ExpenseCategory      @relation(fields: [categoryId], references: [id])
  date          DateTime
  amount        Decimal              @db.Decimal(12, 2)
  currency      String
  description   String
  vendor        String?
  paymentMethod ExpensePaymentMethod @default(OTHER)
  paidBy        ExpensePaidBy        @default(COMPANY)
  userId        String
  user          User                 @relation("ExpenseOwner", fields: [userId], references: [id])
  submittedById String
  submittedBy   User                 @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  status        ExpenseStatus        @default(PENDING)
  source        ExpenseSource        @default(MANUAL)
  // Raw Azure Document Intelligence extraction for a captured receipt: per-field confidence scores,
  // line items, and the model/version used. Null for manually-entered expenses. Informational —
  // the authoritative values are the editable columns above (the user confirms/corrects them).
  captureData   Json?
  decidedById   String?
  decidedBy     User?                @relation("ExpenseDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  receipts ExpenseReceipt[]

  @@index([companyId, date])
  @@index([status])
  @@index([categoryId])
}

// A single receipt can be several files (e.g. a hotel folio + a taxi slip both covering one
// trip expense line) — stored on local disk under uploads/receipts (see src/lib/receipt-
// storage.ts), never in git. `fileName` is the on-disk name (randomized, unrelated to
// `originalName`) so two people's "receipt.jpg" never collide.
model ExpenseReceipt {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id])
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  @@index([expenseId])
}

// ---------- App settings ----------

// Global (app-wide, not company-scoped) key/value settings that must be readable BEFORE auth — e.g.
// the login page and the Credentials authorize() need to know whether password login is enabled.
// First key: "passwordLoginEnabled" ("true"/"false"). Toggled by an Admin at /admin/settings.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Opportunities (sales pipeline) ----------

// A sales opportunity / deal, worked by SALES/PM/Admin (opportunities:manage) through the
// OpportunityStage pipeline. Owner/actor/decider triad mirrors Expense/LeaveRequest/TimeCard:
// `owner` owns the deal, `submittedBy` submitted it for approval, `decidedBy` is the Admin who
// approved/rejected. On WON approval the deal converts to a Project (one Milestone per line) in a
// single transaction and `projectId` is stamped (see src/app/(app)/opportunities/actions.ts).
// Discount is deal-level (not baked into line unit prices): the lines carry list prices, and the
// net figure is computed from discountType/discountValue — that same discount is copied onto the
// created Project.
model Opportunity {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  contactId         String?
  contact           Contact?           @relation(fields: [contactId], references: [id])
  name              String
  // Auto-assigned internal opportunity number, e.g. O-00000001 (unique per company).
  number            String?
  // Free-text internal deal number / client RFQ or tender reference.
  reference         String?
  stage             OpportunityStage   @default(QUALIFYING)
  billingType       ProjectBillingType @default(TIME_AND_MATERIALS)
  currency          String
  expectedCloseDate DateTime?
  // 0-100 win likelihood, drives the weighted-pipeline forecast. Free-form judgement, not derived.
  probability       Int?

  // Deal-level discount off the list total (lines keep list unit prices).
  discountType      DiscountType?
  discountValue     Decimal?           @db.Decimal(12, 2)

  // owner / actor / decider triad
  ownerId           String
  owner             User               @relation("OpportunityOwner", fields: [ownerId], references: [id])
  submittedById     String?
  submittedBy       User?              @relation("OpportunitySubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  decidedById       String?
  decidedBy         User?              @relation("OpportunityDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  decisionComment   String?

  // SoW / PO contract metadata (all optional — PO is not required to approve).
  sowNumber         String?
  sowSignedDate     DateTime?
  poNumber          String?
  poAmount          Decimal?           @db.Decimal(12, 2)
  poDate            DateTime?
  // When the customer PO stops being valid — drives the "PO expiring" alert. poDate is the issue date.
  poValidUntil      DateTime?

  lostReason        String?

  // Set once the opportunity is won and converted; unique so a deal maps to at most one project.
  projectId         String?            @unique
  project           Project?           @relation("OpportunityProject", fields: [projectId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lines      OpportunityLine[]
  revisions  OpportunityRevision[]
  amendments OpportunityAmendment[]
  documents  Document[]
  milestoneAdjustments MilestoneAdjustment[]

  @@unique([companyId, number])
  @@index([companyId, stage])
  @@index([clientId])
}

// One priced line of the current (live) quote. Becomes exactly one Milestone on conversion:
// `unitPrice` -> Milestone.salesPrice (list rate/hr for T&M/RETAINER, lump sum for FIXED_PRICE),
// `quantityHours` -> Milestone.budgetHours. Editable while the deal is open.
model OpportunityLine {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  name          String
  description   String?
  quantityHours Decimal     @db.Decimal(10, 2)
  unitPrice     Decimal     @db.Decimal(12, 4)
  billable      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
}

// An immutable snapshot of the quote each time a proposal is "issued" to the client — the
// negotiation audit trail (v1 initial, v2 after discount, v3 reduced scope, ...). `linesSnapshot`
// is a JSON copy of the lines at issue time (name/quantityHours/unitPrice/billable) so later edits
// to live lines never mutate history. gross/discount/net are frozen at issue time.
model OpportunityRevision {
  id             String        @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id])
  version        Int
  label          String?
  linesSnapshot  Json
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  grossAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  note           String?
  issuedById     String
  issuedBy       User          @relation("OpportunityRevisionIssuedBy", fields: [issuedById], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([opportunityId, version])
  @@index([opportunityId])
}

// A contract amendment / change-order applied to an already-WON opportunity: additional hours
// (and value) agreed after the deal closed. Applying one appends milestone(s) to the linked
// project and bumps the project's contractValue / budgetHours / budgetAmount. Immutable once
// created — `linesSnapshot` is the JSON record of what was added ({name, quantityHours, unitPrice,
// billable, target}) and `addedHours`/`netAmount` freeze the totals. `version` numbers amendments
// per opportunity (1, 2, 3, ...).
model OpportunityAmendment {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  version       Int
  reference     String? // amendment / change-order reference (e.g. "AMD-2")
  poNumber      String? // customer PO covering the amendment, if any
  signedDate    DateTime?
  note          String?
  linesSnapshot Json
  addedHours    Decimal     @db.Decimal(10, 2)
  netAmount     Decimal     @db.Decimal(12, 2) // value added to the project's contract
  appliedById   String
  appliedBy     User        @relation("OpportunityAmendmentAppliedBy", fields: [appliedById], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, version])
  @@index([opportunityId])
  @@index([projectId])
}

// ---------- Documents (invoice / opportunity attachments) ----------

enum DocumentKind {
  FISCAL_INVOICE // the fiscal app's invoice PDF, attached at reconciliation
  CREDIT_NOTE // a customer credit-note document
  SOW // Statement of Work (opportunity)
  PO // Purchase Order (opportunity)
  UAT_ACCEPTANCE // signed UAT / customer acceptance document (project)
  TAX_NOTICE // the accountant's tax notice/assessment PDF (tax payment)
  PAYMENT_RECEIPT // bank payment confirmation/receipt (tax or vendor payment)
  VENDOR_INVOICE // a supplier/vendor's invoice/bill (vendor payment)
  PROJECT_PLAN // project plan (delivery library)
  STATUS_UPDATE // a status update deck/file shared with the customer
  MEETING_MINUTES // meeting minutes document
  KICKOFF // kickoff deck
  SCOPE // scope / SoW document
  CUTOVER_PLAN // cutover plan / go-live runbook shared with the customer
  CERTIFICATE // a person's certification file (profile)
  OTHER
}

// A recorded tax obligation and its payment. TO_PAY once logged from the accountant's notice,
// PAID once settled through the bank (with the payment date + receipt attached).
enum TaxPaymentStatus {
  TO_PAY
  PAID
}

// A file attached to an Invoice OR an Opportunity (exactly one of invoiceId/opportunityId is set,
// enforced in the upload actions). Stored on local disk under uploads/documents (never in public/,
// served only through the authenticated src/app/api/documents/[fileName] route), mirroring how
// ExpenseReceipt handles expense files. `companyId` is denormalized so the serve route can
// tenant-scope without joining the parent.
model Document {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  kind          DocumentKind
  fileName      String // randomized on-disk name (uuid + ext)
  originalName  String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId  String?
  engagement    Engagement?  @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  taxPaymentId  String?
  taxPayment    TaxPayment?  @relation(fields: [taxPaymentId], references: [id], onDelete: Cascade)
  vendorPaymentId String?
  vendorPayment   VendorPayment? @relation(fields: [vendorPaymentId], references: [id], onDelete: Cascade)
  // A minutes / status-update file uploaded to the delivery library also creates the matching
  // MeetingMinutes / StatusReport entry; these link the file to it (SetNull: the file outlives it).
  minutesId       String?
  minutes         MeetingMinutes? @relation(fields: [minutesId], references: [id], onDelete: SetNull)
  statusReportId  String?
  statusReport    StatusReport?   @relation(fields: [statusReportId], references: [id], onDelete: SetNull)
  certification   Certification?
  uploadedAt    DateTime     @default(now())

  @@index([invoiceId])
  @@index([opportunityId])
  @@index([projectId])
  @@index([taxPaymentId])
  @@index([vendorPaymentId])
  @@index([minutesId])
  @@index([statusReportId])
  @@index([companyId])
}

// Vendors/suppliers the company pays (accountant, lawyer, IT, …). Company-scoped, admin-managed
// inline on the Vendor payments page.
model Vendor {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments VendorPayment[]

  @@index([companyId])
}

enum VendorPaymentStatus {
  TO_PAY
  PAID
}

// A bill from a vendor and its payment. TO_PAY once the invoice is logged, PAID once settled.
model VendorPayment {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  // Optional attribution to a project (e.g. a subcontractor bill); overhead bills leave it null.
  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id])
  // Optional finer attribution to a milestone within that project, so fixed-price milestone
  // margin can account for partner cost. Requires projectId to be set as well.
  milestoneId   String?
  milestone     Milestone?          @relation(fields: [milestoneId], references: [id])
  status        VendorPaymentStatus @default(TO_PAY)
  description   String? // what the bill is for (e.g. "Monthly accounting services")
  invoiceNumber String? // the vendor's invoice / reference number
  amount        Decimal             @db.Decimal(12, 2)
  currency      String
  invoiceDate   DateTime? // the vendor invoice/bill date — the primary date dimension
  dueDate       DateTime?
  paymentDate   DateTime? // set when marked PAID
  notes         String?
  recordedById  String
  recordedBy    User                @relation("VendorPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  documents Document[]

  @@index([companyId])
  @@index([vendorId])
  @@index([projectId])
  @@index([milestoneId])
}

// Tax categories (municipality tax, advance sales tax, rent tax, health contributions, social
// security, …). Company-scoped and admin-managed inline on the Taxes page, like ExpenseCategory.
model TaxCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxPayments TaxPayment[]

  @@index([companyId])
}

model TaxPayment {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id])
  categoryId   String
  category     TaxCategory      @relation(fields: [categoryId], references: [id])
  status       TaxPaymentStatus @default(TO_PAY)
  // The tax period this obligation covers — the primary organizing dimension (filter by month).
  // periodEnd is optional so a single month, quarter, or year all fit. Stored at UTC midnight.
  periodStart  DateTime
  periodEnd    DateTime?
  amount       Decimal          @db.Decimal(12, 2)
  currency     String
  serialNumber String? // the tax serial / reference number printed on the notice
  authority    String? // who it's paid to (municipality, tax office, social-security fund, …)
  dueDate      DateTime?
  paymentDate  DateTime? // set when marked PAID
  notes        String?
  recordedById String
  recordedBy   User             @relation("TaxPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  documents Document[]

  @@index([companyId])
  @@index([categoryId])
}

// ---------- Delivery Cockpit (PM governance) ----------

enum RagStatus {
  GREEN
  AMBER
  RED
}

enum RaidType {
  RISK
  ASSUMPTION
  ISSUE
  DEPENDENCY
  DECISION
}

enum RaidStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum RaidSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Company master playbook: the standard governance checklist applied to every new project so a
// junior PM follows the same procedure every time. Admin-managed.
// A periodic project status report the PM builds in-app and exports to Excel for the customer.
model StatusReport {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId    String?
  engagement      Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  reportDate      DateTime
  periodStart     DateTime?
  periodEnd       DateTime?
  cadence         String? // WEEKLY | MONTHLY | ADHOC
  // overallRag is the "Severity/Timing" flag on the customer deck: GREEN=Low/On time,
  // AMBER=Medium/Delay, RED=High/Business impact.
  overallRag      RagStatus @default(GREEN)
  scheduleRag     RagStatus @default(GREEN)
  budgetRag       RagStatus @default(GREEN)
  scopeRag        RagStatus @default(GREEN)
  progressPercent Int? // 0-100 progress, shown as "Progress (90%)" on the status slide
  summary            String? // "Current status" narrative
  accomplishments    String? // done this period (optional extra)
  nextSteps          String? // free-text plan (optional; structured actions live in `actions`)
  correctiveActions  String? // "Corrective Actions" section
  decisionsNeeded    String?
  milestoneNotes     String?
  sentAt          DateTime? // when shared with the customer
  authorId        String
  author          User      @relation("StatusReportAuthor", fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  actions   StatusReportAction[]
  documents Document[]

  @@index([projectId])
  @@index([companyId])
}

// A "Next Action" line on a status report: description + owner + due date + a Critical flag, exactly
// like the bulleted next-actions on the customer status deck.
model StatusReportAction {
  id          String       @id @default(cuid())
  reportId    String
  report      StatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  description String
  owner       String?
  dueDate     DateTime?
  critical    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([reportId])
}

// A RAID entry (Risk / Assumption / Issue / Dependency / Decision) — the governance backbone that
// feeds the status report's highlights.
model RaidItem {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?  @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  type        RaidType
  title       String
  description String?
  severity    RaidSeverity?
  status      RaidStatus    @default(OPEN)
  owner       String? // free-text owner (may be client-side)
  dueDate     DateTime?
  response    String? // mitigation / resolution / decision detail
  createdById String
  createdBy   User          @relation("RaidCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
  @@index([companyId])
}

// ---------- Meeting minutes ----------

model MeetingMinutes {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  date        DateTime
  title       String
  attendees   String? // legacy free-text list; superseded by structured `participants`
  notes       String? // discussion / minutes body
  // TDM156 header fields
  timeFrom       String? // e.g. "09:00"
  timeTo         String? // e.g. "10:00"
  location       String? // e.g. "MS Teams"
  minuteTaker    String?
  agendaTopic    String? // meeting agenda topic(s)
  agendaWho      String? // e.g. "All"
  agendaDuration String? // e.g. "1:00"
  createdById String
  createdBy   User     @relation("MinutesCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions      MeetingActionItem[]
  participants MeetingParticipant[]
  documents    Document[]

  @@index([projectId])
  @@index([companyId])
}

model MeetingActionItem {
  id          String         @id @default(cuid())
  minutesId   String
  minutes     MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  description String
  owner       String?
  dueDate     DateTime?
  done        Boolean        @default(false)
  sortOrder   Int            @default(0)

  @@index([minutesId])
}

// A row in the TDM156 participants table: Name · Company · Role · Group.
model MeetingParticipant {
  id        String         @id @default(cuid())
  minutesId String
  minutes   MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  role      String?
  group     String?
  sortOrder Int            @default(0)

  @@index([minutesId])
}

// ---------- SOP coaching guides ("How do I handle this?") ----------

// A short, admin-editable playbook card distilled from a company SOP: a situation a PM might face
// (a change request, a slipping date, an unhappy customer) and the concrete steps to handle it.
// Surfaced as contextual help in the Delivery cockpit — guidance, never a gate.
model SopGuide {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String // the situation, e.g. "A customer asks for extra work"
  category  String // grouping/trigger key: change_request | slipping_date | kickoff | unhappy_customer | escalation | status | golive | general
  summary   String? // one-line "when to use this"
  steps     String // newline-separated action steps
  source    String? // SOP citation, e.g. "SOP: Change Requests"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ---------- Project plan ----------

enum PlanTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

// One line of a project's delivery plan (like an MS Planner / Project row): a task or a milestone
// (go-live, quality gate) with owner, dates, progress and status. Shared with the customer and
// updated as the project progresses.
model PlanTask {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  phase       String? // grouping, e.g. "Analysis & Design & Build", "Deployment & Transition"
  name        String
  owner       String? // who's working on it (may be internal, customer or partner side)
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int            @default(0) // 0-100 % complete
  status      PlanTaskStatus @default(NOT_STARTED)
  isMilestone Boolean        @default(false) // a gate/milestone (Go-live, Quality Ready, …)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@index([companyId])
}

// ---------- Cutover plan (go-live runbook) ----------

enum CutoverStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

// One line of a project's cutover/go-live runbook: a concrete activity (get production access, move
// TRs, run a config step, stop a job…) grouped under a macro activity/phase, with an owner (may be
// internal, the customer, or another provider), a planned window, effort, and status. Editable by the
// PM and by any consultant assigned to the project; exportable to Excel for the go-live team.
model CutoverTask {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId          String
  plan            CutoverPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Parent activity (one level of nesting): a parent step like "Start production configuration" with
  // child steps "Configure T-code X", "Configure table Y". Deleting a parent removes its children.
  parentId        String?
  parent          CutoverTask?  @relation("CutoverChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        CutoverTask[] @relation("CutoverChildren")
  macroActivity   String // grouping/phase, e.g. "Preparation", "Transport to production", "Go-live"
  activity        String // the concrete step
  description     String?
  responsible     String? // free text — internal, customer, or partner (multi-provider go-lives)
  prerequisite    String? // free text — the step number(s) that must be done first, e.g. "3" or "3.1, 4"
  referenceList   String? // name of a CutoverList (detail tab) this step points to, e.g. "TRANSPORT LIST"
  startDate       DateTime?
  endDate         DateTime?
  durationMinutes Int? // planned effort/duration for the step
  status          CutoverStatus @default(PENDING)
  sortOrder       Int           @default(0) // order among siblings (same parent)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@index([planId])
  @@index([companyId])
  @@index([parentId])
}

// A named detail table referenced by cutover steps (e.g. "TRANSPORT LIST", "JOBS", "TABLE ENTRIES").
// Stored as a simple grid: `columns` = header strings, `rows` = array of value arrays. Exported as its
// own tab in the cutover workbook so steps can say "import the TRs in tab TRANSPORT LIST".
model CutoverList {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId    String
  plan      CutoverPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String
  columns   Json // string[]
  rows      Json // string[][]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, name])
  @@index([projectId])
  @@index([planId])
  @@index([companyId])
}

/// A go-live runbook. A project can hold several (one per end customer, per phase, per wave); each
/// optionally belongs to an Engagement so it shows under that end customer in the cockpit.
model CutoverPlan {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  name         String
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        CutoverTask[]
  lists        CutoverList[]

  @@index([projectId])
  @@index([engagementId])
  @@index([companyId])
}

// ---------- UAT test scripts (customer-shared test scenarios + results) ----------

enum UatResult {
  NOT_RUN
  OK
  KO
  REDO
}

enum UatScriptStatus {
  DRAFT // being prepared by the consultant
  READY // prepared, ready to send
  SENT // shared with the customer
}

enum UatIssueStatus {
  OPEN
  CLOSED
}

/// A customer test script. Several per project (per end customer / phase), each with its own
/// DRAFT -> READY -> SENT governance; areas, cases and issues hang off the script.
model UatScript {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?     @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  name         String
  status       UatScriptStatus @default(DRAFT)
  sentAt       DateTime?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  areas        UatArea[]
  cases        UatTestCase[]
  issues       UatIssue[]

  @@index([projectId])
  @@index([engagementId])
  @@index([companyId])
}

// A functional area / test group (e.g. "Company Code Determination"), holding its own test cases.
model UatArea {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId         String
  script           UatScript     @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  name             String
  overview         String?
  dataRequirements String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  cases            UatTestCase[]

  @@index([scriptId])
  @@index([projectId])
  @@index([companyId])
}

// One test case (scenario + expected result + run outcome) inside a functional area.
model UatTestCase {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id])
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId         String
  script           UatScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  areaId           String
  area             UatArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  description      String?
  prerequisites    String?
  expectedResults  String?
  runBy            String?
  dateRun          DateTime?
  result           UatResult @default(NOT_RUN)
  reasonForFailure String?
  docNo            String?
  comments         String?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([areaId])
  @@index([scriptId])
  @@index([projectId])
  @@index([companyId])
}

// The defect/issue log for a project's UAT (the "Test Issue Summary" tab).
model UatIssue {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId         String
  script           UatScript      @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  areaRef          String? // which area/tab
  testRef          String? // which test #
  type             String? // OK/KO/Redo/etc.
  description      String?
  correctiveAction String?
  assigned         String?
  status           UatIssueStatus @default(OPEN)
  dateRaised       DateTime?
  dateClosed       DateTime?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([scriptId])
  @@index([projectId])
  @@index([companyId])
}

// ---------- Ticketing (ITIL-style incidents / service requests / changes) ----------

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Semantic bucket a configurable status maps to. Drives board grouping, "is it open" (SLA clocks
// run only while OPEN/IN_PROGRESS), and which timestamps get stamped (DONE→resolvedAt/closedAt).
enum TicketStatusCategory {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// Data type of a configurable custom field. Values live in TicketFieldValue as JSON.
enum TicketFieldKind {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  USER
}

// ---------- Ticketing configuration (per company, admin-managed) ----------

// A ticket "type"/category (Incident, Bug, Change request, Task, …). Each owns its own workflow
// (TicketStatusDef) and optional custom fields. Seeded with sensible defaults per company.
model TicketTypeDef {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  key               String // stable slug, unique per company
  name              String
  description       String?
  icon              String? // key into the client-side icon registry
  color             String? // token/hex for the type chip
  order             Int      @default(0)
  active            Boolean  @default(true)
  isDefault         Boolean  @default(false) // pre-selected type on new tickets
  customerCanCreate Boolean  @default(true) // customers may open this type from the portal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  statuses TicketStatusDef[]
  fields   TicketFieldDef[]
  tickets  Ticket[]

  @@unique([companyId, key])
  @@index([companyId])
}

// A status in a type's workflow. Per-type, so Bugs and Change requests can differ.
model TicketStatusDef {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  typeId          String
  type            TicketTypeDef        @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key             String
  name            String
  color           String?
  category        TicketStatusCategory @default(OPEN)
  order           Int                  @default(0)
  isInitial       Boolean              @default(false) // starting status for a new ticket of this type
  customerVisible Boolean              @default(true) // shown to portal users
  customerCanSet  Boolean              @default(false) // portal users may move a ticket into this status
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tickets Ticket[]

  @@unique([typeId, key])
  @@index([companyId])
  @@index([typeId])
}

// A custom field definition. typeId null = applies to every type; set = only that type.
model TicketFieldDef {
  id               String          @id @default(cuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  typeId           String?
  type             TicketTypeDef?  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key              String
  name             String
  kind             TicketFieldKind @default(TEXT)
  options          Json? // string[] for SELECT/MULTISELECT
  required         Boolean         @default(false)
  customerVisible  Boolean         @default(true)
  customerEditable Boolean         @default(false)
  order            Int             @default(0)
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  values TicketFieldValue[]

  @@unique([companyId, typeId, key])
  @@index([companyId])
}

model TicketFieldValue {
  id       String         @id @default(cuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fieldId  String
  field    TicketFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value    Json // string | number | boolean | string[] | userId, per field.kind

  @@unique([ticketId, fieldId])
  @@index([fieldId])
}

// A saved view: filter + column layout + sort, owned by a user, optionally shared company-wide.
model TicketView {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  shared    Boolean  @default(false)
  filters   Json     @default("{}") // { typeIds, statusCategories, priorities, assigneeIds, clientIds, projectIds, text, mine }
  columns   Json     @default("[]") // ordered column keys (native + "cf:<fieldKey>")
  sort      Json? // { key, dir }
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([ownerId])
}

// SLA response/resolution targets. One row per company is the default (clientId null); an optional
// row per client overrides it. `targets` is JSON keyed by priority: { LOW:{respond,resolve}, … } in hours.
model SlaPolicy {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  clientId  String? // null = company-wide default
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientId])
  @@index([companyId])
  @@index([clientId])
}

// Per-user in-app notification about activity on a ticket they're involved in (reply / status
// change / assignment). `kind` is a free-string ("COMMENT"|"STATUS"|"ASSIGN"); actorName + summary
// are snapshots so the bell renders without extra joins. Read when readAt is set.
model TicketNotification {
  id        String    @id @default(cuid())
  companyId String
  userId    String // recipient
  user      User      @relation(fields: [userId], references: [id])
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind      String
  actorName String
  summary   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([ticketId])
}

// Entries in a ticket's activity thread: free-text comments plus auto-logged system events.
enum TicketActivityKind {
  CREATED
  COMMENT
  STATUS
  ASSIGN
  PRIORITY
  RESOLVED
  REOPENED
}

model Ticket {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  number          String // TKT-00000001, unique per company
  title           String
  description     String?
  typeId          String
  typeDef         TicketTypeDef   @relation(fields: [typeId], references: [id])
  priority        TicketPriority  @default(MEDIUM)
  statusId        String
  statusDef       TicketStatusDef @relation(fields: [statusId], references: [id])
  requesterId     String
  requester       User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId      String?
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdById     String
  createdBy       User           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  category        String?
  systemRef       String? // configuration item / SAP system (e.g. DA1)
  moduleRef       String? // functional module (e.g. FI, MM, AP)
  dueDate         DateTime?
  // SLA targets, computed from priority at create / on priority change.
  respondBy       DateTime?
  resolveBy       DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  resolution      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments    TicketComment[]
  worklogs    TicketWorklog[]
  attachments TicketAttachment[]
  fieldValues TicketFieldValue[]
  notifications TicketNotification[]

  @@unique([companyId, number])
  @@index([companyId, statusId])
  @@index([typeId])
  @@index([statusId])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([clientId])
  @@index([projectId])
}

model TicketComment {
  id        String             @id @default(cuid())
  ticketId  String
  ticket    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  kind      TicketActivityKind @default(COMMENT)
  body      String?
  // Staff-only note: hidden from the customer portal. Customer-authored comments are never internal.
  internal  Boolean            @default(false)
  // Threaded replies: a reply points at the comment it answers. Top-level comments leave it null.
  parentId  String?
  parent    TicketComment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TicketComment[]    @relation("CommentThread")
  attachments TicketAttachment[]
  // Set when a comment's text is edited / when it's soft-deleted (tombstoned so replies survive).
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime           @default(now())

  @@index([ticketId])
  @@index([parentId])
}

model TicketWorklog {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  minutes   Int
  workedOn  DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([ticketId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Attachments dropped onto a specific comment/reply (SAP screenshots etc.). Null = ticket-level.
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  companyId    String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([ticketId])
  @@index([commentId])
}

// ---------- Engagements (end-customer streams inside a project's delivery cockpit) ----------

// A project-management-only breakdown of a project into end-customer streams (e.g. Zambon,
// Bonfiglioli, Q8 under a Tungsten project). It never creates a separate Project/budget/invoice —
// governance items (status reports, plan, RAID, minutes, documents) are optionally scoped to one.
enum EngagementStatus {
  ACTIVE
  COMPLETED
}

model Engagement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// An end customer can be finished while the umbrella project (e.g. a portfolio) stays open.
  status      EngagementStatus @default(ACTIVE)
  completedAt DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusReports StatusReport[]
  planTasks     PlanTask[]
  cutoverPlans  CutoverPlan[]
  uatScripts    UatScript[]
  raidItems     RaidItem[]
  meetings      MeetingMinutes[]
  documents     Document[]
  members       EngagementMember[]

  @@index([projectId])
  @@index([companyId])
}

/// The people assigned to an end-customer engagement. Membership grants delivery access to the
/// project's cockpit tools and scopes what a non-manager sees to their own end customers.
model EngagementMember {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([engagementId, userId])
  @@index([userId])
}

/// Which internal staff look after a client's support tickets (the AMS team for that account).
/// Membership GRANTS access to that client's tickets, and for non-admins it also SCOPES what they
/// see — an admin sees every client, everyone else sees the clients they're a member of (plus any
/// ticket they personally raised or are assigned, so nothing can vanish from under them).
model ClientTeamMember {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("ClientTeamMemberUser", fields: [userId], references: [id])
  role        ClientTeamRole @default(MEMBER)
  createdAt   DateTime       @default(now())
  createdById String?
  createdBy   User?          @relation("ClientTeamMemberCreatedBy", fields: [createdById], references: [id])

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

enum ClientTeamRole {
  /// Owns the account: first point of escalation. Shown first on the team list.
  LEAD
  MEMBER
}

/// Ledger of operational alerts that were actually sent (see src/lib/alerts). The unique key is the
/// dedup guarantee: a rule that runs every day can only ever send a given (kind, target, payload)
/// once — "80% of budget" for project X fires exactly one time. channel/recipient are a summary of
/// the fan-out for that one alert (e.g. "email,teams" / the addresses), kept for audit.
model Notification {
  id          String   @id @default(cuid())
  companyId   String
  kind        String
  targetType  String
  targetId    String
  sentAt      DateTime @default(now())
  channel     String
  recipient   String
  payloadHash String

  @@unique([kind, targetId, payloadHash])
  @@index([companyId, kind])
  @@index([sentAt])
}

/// Append-only change history. No relation to User on purpose: an actor being deleted must never
/// touch (cascade into, or null out) an audit row — the DB trigger in the migration would reject
/// it anyway. Actor names are resolved at read time.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  entityType String
  entityId   String
  action     String
  actorId    String
  at         DateTime @default(now())
  summary    String
  diff       Json

  @@index([entityType, entityId, at])
  @@index([companyId, at])
}

// ---------- skills & certifications (staffing: module, technology, language, industry, method) ----------

enum SkillCategory {
  SAP_MODULE
  TECHNOLOGY
  LANGUAGE
  INDUSTRY
  METHODOLOGY
}

/// The company's skill catalogue (admin-managed). People rate themselves against it.
model Skill {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  name       String
  category   SkillCategory
  createdAt  DateTime      @default(now())
  userSkills UserSkill[]

  @@unique([companyId, name])
  @@index([companyId, category])
}

/// A person's self-assessed level (1 basic … 5 expert) on a catalogue skill.
model UserSkill {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level        Int
  lastUsedYear Int?
  updatedAt    DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([skillId])
}

/// A certification held by a person; the certificate file is a Document (kind CERTIFICATE).
model Certification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedDate DateTime?
  expiryDate DateTime?
  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([expiryDate])
}
