generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum SystemRole {
  ADMIN
  FINANCE
  SALES
  PM
  EMPLOYEE
  CONTRACTOR
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectBillingType {
  TIME_AND_MATERIALS
  FIXED_PRICE
  RETAINER
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETE
  INVOICED
}

enum AssignmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TimeCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Register/reconciliation lifecycle: recorded (DRAFT) -> finalized & revenue recognized (ISSUED)
// -> matched to the fiscal app + customer document (RECONCILED) -> settled (PAID). VOID cancels.
enum InvoiceStatus {
  DRAFT
  ISSUED
  RECONCILED
  PAID
  VOID
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Sales pipeline position for an Opportunity. The open stages (QUALIFYING -> PROPOSAL_SENT ->
// NEGOTIATION) are freely moved by anyone with opportunities:manage. PENDING_APPROVAL is the
// deal-desk gate: a manager submits, and only an Admin (opportunities:approve) can move it to
// WON (which auto-creates the Project + Milestones) or bounce it back to NEGOTIATION. LOST /
// CANCELLED are terminal.
enum OpportunityStage {
  QUALIFYING
  PROPOSAL_SENT
  NEGOTIATION
  PENDING_APPROVAL
  WON
  LOST
  CANCELLED
}

// How a discount is expressed: PERCENT (discountValue is a 0-100 percentage of the list total)
// or ABSOLUTE (discountValue is a fixed money amount in the deal currency).
enum DiscountType {
  PERCENT
  ABSOLUTE
}

// ---------- Core / Foundation ----------

model Company {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  projects          Project[]
  invoices          Invoice[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  opportunities     Opportunity[]
  documents         Document[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  email        String     @unique
  passwordHash String
  name         String
  role         SystemRole @default(EMPLOYEE)
  active       Boolean    @default(true)
  // Self-service profile fields — editable by the person themselves on /profile (never email,
  // password, or role). `avatarUrl` stores just the on-disk file name (served, authenticated,
  // through /api/avatars/[fileName]); everything else is free text.
  title        String?
  phone        String?
  location     String?
  bio          String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employment            Employment?
  salaries              Salary[]
  projectsManaged       Project[]              @relation("ProjectManager")
  assignments           Assignment[]
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  timeEntries           TimeEntry[]
  timeCards             TimeCard[]
  timeCardApprovals     TimeCard[]             @relation("TimeCardApprover")
  timeCardSubmissions   TimeCard[]             @relation("TimeCardSubmitter")
  milestoneReallocations MilestoneReallocation[]
  leaveRequests        LeaveRequest[] @relation("LeaveOwner")
  leaveRequestsMade    LeaveRequest[] @relation("LeaveRequestedBy")
  leaveRequestsDecided LeaveRequest[] @relation("LeaveDecidedBy")
  leaveReturnsRecorded LeaveReturn[]
  expensesOwned        Expense[] @relation("ExpenseOwner")
  expensesSubmitted    Expense[] @relation("ExpenseSubmittedBy")
  expensesDecided      Expense[] @relation("ExpenseDecidedBy")
  opportunitiesOwned     Opportunity[] @relation("OpportunityOwner")
  opportunitiesSubmitted Opportunity[] @relation("OpportunitySubmittedBy")
  opportunitiesDecided   Opportunity[] @relation("OpportunityDecidedBy")
  opportunityRevisions   OpportunityRevision[] @relation("OpportunityRevisionIssuedBy")
  opportunityAmendments  OpportunityAmendment[] @relation("OpportunityAmendmentAppliedBy")
  documents              Document[]

  @@index([companyId])
}

/** Per-user salary history: cost rate is derived from this, never entered directly. Multiple
 *  rows let a promotion/raise take effect on a specific date without losing the prior rate's
 *  history (used when computing historically-accurate cost basis). */
model Salary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  monthlyAmount Decimal  @db.Decimal(12, 2)
  currency      String // "ALL" or "EUR" — some contractors are paid directly in EUR
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, effectiveFrom])
}

/** Historical currency conversion rates (e.g. ALL->EUR), quoted as "how many `fromCurrency`
 *  units equal 1 `toCurrency` unit" (e.g. rate 105.5 means 105.5 ALL = 1 EUR). */
model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(14, 6)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveFrom])
  @@index([fromCurrency, toCurrency, effectiveFrom])
}

model Employment {
  id         String         @id @default(cuid())
  userId     String         @unique
  user       User           @relation(fields: [userId], references: [id])
  type       EmploymentType @default(EMPLOYEE)
  costRate   Decimal        @db.Decimal(10, 4)
  startDate  DateTime
  endDate    DateTime?
  // Manual opening vacation balance, for teams onboarded onto the app mid-life (no historical
  // LeaveRequests to derive carryover from). When both are set, computeVacationBalance seeds its
  // year-walk with `carriedInVacationDays` as the balance at Jan 1 of `carriedInVacationYear`
  // and grants full annual entitlement from that year on, instead of summing from the hire date.
  carriedInVacationDays Decimal?  @db.Decimal(5, 2)
  carriedInVacationYear Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ---------- Clients ----------

model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  projects Project[]
  invoices Invoice[]
  opportunities Opportunity[]

  @@index([companyId])
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  opportunities Opportunity[]

  @@index([clientId])
}

// ---------- Projects / Milestones / Assignments ----------

model Project {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id])
  name         String
  status       ProjectStatus      @default(PLANNED)
  billingType  ProjectBillingType @default(TIME_AND_MATERIALS)
  startDate    DateTime?
  endDate      DateTime?
  budgetAmount Decimal?           @db.Decimal(12, 2)
  budgetHours  Decimal?           @db.Decimal(8, 2)
  managerId    String?
  manager      User?              @relation("ProjectManager", fields: [managerId], references: [id])
  // Flags a project as company-internal (not billed to a real client) — e.g. an umbrella
  // project for vacation tracking. Still requires a Client like any project (create a
  // placeholder one); this flag just filters it into pickers like the vacation-approval
  // project selector instead of any structural difference.
  isInternal   Boolean            @default(false)
  // Contract terms carried over when a Project is created from a won Opportunity. Milestones keep
  // the list sales price; the negotiated discount lives here (type + value) alongside the resulting
  // net `contractValue`, so the discount is always visible on the project without re-pricing every
  // milestone. `sowNumber`/`poNumber` mirror the SoW/PO captured on the opportunity (poNumber also
  // feeds invoice defaults). All nullable — a hand-created project (no opportunity) simply leaves
  // them unset.
  discountType   DiscountType?
  discountValue  Decimal?           @db.Decimal(12, 2)
  contractValue  Decimal?           @db.Decimal(12, 2)
  sowNumber      String?
  poNumber       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  milestones Milestone[]
  opportunity Opportunity? @relation("OpportunityProject")
  amendments  OpportunityAmendment[]
  invoices    Invoice[]

  @@index([companyId])
  @@index([clientId])
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  name          String
  description   String?
  billable      Boolean         @default(true)
  salesPrice    Decimal         @db.Decimal(12, 4)
  cost          Decimal         @db.Decimal(12, 2)
  budgetHours   Decimal?        @db.Decimal(8, 2)
  startDate     DateTime?
  endDate       DateTime?
  timeEntryOpen Boolean         @default(true)
  status        MilestoneStatus @default(PLANNED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assignments      Assignment[]
  tasks            Task[]
  timeEntries      TimeEntry[]
  timeCards        TimeCard[]
  invoiceLines     InvoiceLine[]
  reallocationsFrom MilestoneReallocation[] @relation("ReallocFrom")
  reallocationsTo   MilestoneReallocation[] @relation("ReallocTo")
  leaveRequests     LeaveRequest[]

  @@index([projectId])
}

model Assignment {
  id             String           @id @default(cuid())
  milestoneId    String
  milestone      Milestone        @relation(fields: [milestoneId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  costRate       Decimal          @db.Decimal(10, 4)
  allocatedHours Decimal?         @db.Decimal(8, 2)
  startDate      DateTime
  endDate        DateTime
  status         AssignmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  timeEntries TimeEntry[]
  timeCards   TimeCard[]
  planEntries AssignmentPlan[]
  leaveRequests LeaveRequest[]

  @@unique([milestoneId, userId])
}

// A planned-hours cell. `taskId` NULL = assignment-level plan (one number for the whole
// assignment that week); `taskId` set = a task-level breakdown row. Invariant (enforced by the
// NULLS NOT DISTINCT unique index): for any (assignment, week) there is EITHER one assignment-level
// row OR one-or-more task-level rows, never both — so summing `hours` by assignment always gives
// the correct weekly total with no double counting.
model AssignmentPlan {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  hours         Decimal    @db.Decimal(6, 2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assignmentId, taskId, weekStartDate])
  @@index([weekStartDate])
  @@index([taskId])
}

model Task {
  id             String     @id @default(cuid())
  milestoneId    String
  milestone      Milestone  @relation(fields: [milestoneId], references: [id])
  name           String
  description    String?
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  estimatedHours Decimal?   @db.Decimal(8, 2)
  startDate      DateTime?
  dueDate        DateTime?
  status         TaskStatus @default(TODO)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  timeEntries     TimeEntry[]
  assignmentPlans AssignmentPlan[]

  @@index([milestoneId])
}

// ---------- Time tracking & approvals ----------

// One TimeCard is one "line" in the weekly time grid: a single assignment for a single week,
// with its own independent lifecycle (DRAFT -> SUBMITTED -> APPROVED/REJECTED). It can span
// several tasks under that assignment (each task is just a row of hours within the same card —
// tasks don't carry their own status and don't feed invoicing on their own, only the
// assignment/milestone does). A person can have several TimeCards open in the same week across
// different projects, each decided independently by that project's manager — and can add a
// brand-new TimeCard for the same assignment/week as a correction line once an earlier one is
// APPROVED (those are frozen).
model TimeCard {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  assignmentId  String
  assignment    Assignment     @relation(fields: [assignmentId], references: [id])
  milestoneId   String
  milestone     Milestone      @relation(fields: [milestoneId], references: [id])
  weekStartDate DateTime
  status        TimeCardStatus @default(DRAFT)
  submittedAt   DateTime?
  // Who actually clicked Submit — distinct from `user` (whose time this is): a PM/Admin
  // proxy-submitting on someone else's behalf means these two differ.
  submittedById String?
  submittedBy   User?          @relation("TimeCardSubmitter", fields: [submittedById], references: [id])
  approverId    String?
  approver      User?          @relation("TimeCardApprover", fields: [approverId], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  entries TimeEntry[]

  @@index([userId, weekStartDate])
  @@index([assignmentId])
  @@index([approverId, status])
}

model TimeEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  assignmentId  String
  assignment    Assignment   @relation(fields: [assignmentId], references: [id])
  milestoneId   String
  milestone     Milestone    @relation(fields: [milestoneId], references: [id])
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  timeCardId    String
  timeCard      TimeCard     @relation(fields: [timeCardId], references: [id])
  date          DateTime
  hours         Decimal      @db.Decimal(5, 2)
  // Historical cost rate (EUR/h) frozen onto the entry when its card is APPROVED — the rate that
  // was correct on `date` (salary + FX effective then). Null until approved / for legacy rows;
  // cost math falls back to the assignment's snapshot rate when null. See src/lib/cost-rate.ts.
  costRate      Decimal?     @db.Decimal(10, 4)
  description   String?
  invoiceLineId String?
  invoiceLine   InvoiceLine? @relation(fields: [invoiceLineId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([timeCardId, taskId, date])
  @@index([userId, date])
  @@index([assignmentId])
  @@index([milestoneId, date])
  @@index([timeCardId])
}

// ---------- Leave (vacation, sick, parental) ----------

enum LeaveType {
  VACATION
  SICK
  PATERNITY
  MATERNITY
}

// A request for time off, of any LeaveType. `workingDays` is computed at request time (working
// days in the range, excluding weekends and Albanian public holidays). Only VACATION has an
// annual entitlement/balance (see computeVacationBalance) — SICK is uncapped/just tracked, and
// PATERNITY/MATERNITY are one-time per-event periods with no preset duration, both without any
// balance math. Admin-created requests are auto-approved for every type (no separate decision
// step) — `requestedById` still distinguishes "who filed this" from `userId` ("whose leave it
// is"), same pattern as TimeCard.submittedById.
// On approval, `milestoneId`/`assignmentId` point at the auto-created (or reused) non-billable
// milestone + assignment (named per type, e.g. "Sick Leave") under whichever internal project
// the approver chose — see src/lib/vacation.ts#provisionLeave for how those get created and how
// the days get mirrored into AssignmentPlan and pre-approved TimeCards.
model LeaveRequest {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation("LeaveOwner", fields: [userId], references: [id])
  type          LeaveType      @default(VACATION)
  startDate     DateTime
  endDate       DateTime
  workingDays   Decimal        @db.Decimal(5, 2)
  status        VacationStatus @default(PENDING)
  reason        String?
  requestedById String
  requestedBy   User           @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  milestoneId   String?
  milestone     Milestone?     @relation(fields: [milestoneId], references: [id])
  assignmentId  String?
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  returns LeaveReturn[]

  @@index([userId, startDate])
  @@index([status])
  @@index([type])
}

// Records an early/partial return to work *within* an already-APPROVED LeaveRequest's date
// range — e.g. someone comes back a week early from vacation and stays, or comes back for a
// couple of days mid-sick-leave and then goes back out. A single LeaveRequest can have several
// of these (handles the intermittent case, not just a single early end), each independently
// validated to fall inside the request's range and not overlap another return. Recording one
// un-provisions those specific days (see src/lib/vacation.ts#recordLeaveReturn): removes the
// matching TimeEntry rows, decrements the affected AssignmentPlan weeks, and decrements the
// parent LeaveRequest.workingDays — which is what actually gives the days back to
// computeVacationBalance for VACATION (SICK/PATERNITY/MATERNITY have no balance to give back to,
// but still get the same un-provisioning).
model LeaveReturn {
  id             String       @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  startDate      DateTime
  endDate        DateTime
  workingDays    Decimal      @db.Decimal(5, 2)
  recordedById   String
  recordedBy     User         @relation(fields: [recordedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([leaveRequestId])
}

// ---------- Milestone reallocation ----------

model MilestoneReallocation {
  id             String    @id @default(cuid())
  fromMilestoneId String
  fromMilestone  Milestone @relation("ReallocFrom", fields: [fromMilestoneId], references: [id])
  toMilestoneId  String
  toMilestone    Milestone @relation("ReallocTo", fields: [toMilestoneId], references: [id])
  hours          Decimal   @db.Decimal(8, 2)
  hoursReceived  Decimal   @db.Decimal(8, 2)
  costMoved      Decimal   @db.Decimal(12, 2)
  byUserId       String
  byUser         User      @relation(fields: [byUserId], references: [id])
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([fromMilestoneId])
  @@index([toMilestoneId])
}

// ---------- Invoicing ----------

// An entry in the invoice REGISTER — RM Ops does not generate fiscal documents (the external
// fiscal app does); this records what was billed against a project, ties it to the fiscal app's
// number and the customer's document, tracks revenue recognition, and reconciles the two.
model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  // What this invoice bills. Optional so a client-level or ad-hoc entry is still possible.
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  // Our internal register number (e.g. INV-0001) — always ours, distinct from the fiscal number.
  invoiceNumber   String
  type            InvoiceType   @default(INVOICE)
  status          InvoiceStatus @default(DRAFT)
  // German self-billing (Gutschrift): the customer issued a credit note and we record a matching
  // invoice for revenue recognition only — never sent to them.
  selfBilled      Boolean       @default(false)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  // Revenue-recognition date for month-end cutoff (falls back to issueDate when null).
  recognitionDate DateTime?
  // Service period — only meaningful for time-based invoices, hence optional.
  periodStart     DateTime?
  periodEnd       DateTime?
  currency        String        @default("USD")
  // VAT percentage; net comes from the lines, gross = net + net*vatRate. The fiscal app is the
  // source of truth for tax — this is captured for management totals only.
  vatRate         Decimal?      @db.Decimal(5, 2)
  // Optional sales-commission discount, expressed as a percentage of the invoice's line net
  // and/or a flat amount (they combine: discount = net*commissionPercent/100 + commissionFixed).
  // The resulting figure is materialised as the negative "Sales comision" line; these two fields
  // remember how it was entered so it round-trips on edit and % recomputes if the lines change.
  commissionPercent Decimal?    @db.Decimal(5, 2)
  commissionFixed   Decimal?    @db.Decimal(12, 2)
  // Reconciliation references.
  fiscalNumber    String? // the external fiscal app's invoice number
  fiscalReference String? // any extra fiscal-side reference
  customerReference String? // customer PO / credit-note number / their document ref
  poNumber        String?
  referenceNumber String?
  issuedAt        DateTime?
  reconciledAt    DateTime?
  notes           String?
  // A credit note can point at the original invoice it adjusts.
  creditNoteForId String?
  creditNoteFor   Invoice?      @relation("InvoiceCreditNotes", fields: [creditNoteForId], references: [id])
  creditNotes     Invoice[]     @relation("InvoiceCreditNotes")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines     InvoiceLine[]
  payments  InvoicePayment[]
  documents Document[]

  @@unique([companyId, invoiceNumber])
  @@index([clientId])
  @@index([projectId])
  @@index([companyId, status])
}

// A partial (or full) payment recorded against an invoice. Outstanding = gross − Σ payments.
model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  method    String?
  reference String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  description String
  quantity    Decimal    @db.Decimal(8, 2)
  rate        Decimal    @db.Decimal(10, 4)
  amount      Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  timeEntries TimeEntry[]

  @@index([invoiceId])
  @@index([milestoneId])
}

// ---------- Expenses ----------

enum ExpensePaidBy {
  COMPANY  // paid directly from company funds (bank transfer, cash, company card) — nobody is owed money back
  EMPLOYEE // the user paid personally and is owed reimbursement
}

enum ExpenseStatus {
  DRAFT // captured via the /capture PWA, not yet confirmed — excluded from approvals + reports
  PENDING
  APPROVED
  REJECTED
}

// How an expense record was created: MANUAL (the /expenses form) or CAPTURE (the /capture PWA
// receipt-scan flow, which pre-fills fields from Azure Document Intelligence).
enum ExpenseSource {
  MANUAL
  CAPTURE
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

// Admin/Finance-managed list of spending types (Utilities, Travel, ...) — kept editable rather
// than a fixed enum since the user was explicit this list isn't exhaustive ("and other stuff").
model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId])
}

// A single expense line — the primary record accountants reconcile against bank statements at
// year-end, hence the emphasis on always capturing date/amount/description even when there's no
// receipt (e.g. a cash-paid recurring fee with no invoice issued, a real problem the user
// flagged specifically). `userId` is whose expense this is (for EMPLOYEE: who gets reimbursed;
// for COMPANY: who handled/paid it, e.g. with the company card) — distinct from `submittedById`
// (who actually filed the record), same "owner vs actor" pattern used by TimeCard/LeaveRequest.
// Auto-approval: whenever `submittedBy` has `expenses:manage` (Admin/Finance), the record lands
// already APPROVED regardless of paidBy — anyone else's entry (of either paidBy type) goes to
// PENDING for review, since the point of approval here isn't just authorizing a reimbursement
// payout, it's confirming the record is accurate/correctly categorized before it hits the books.
model Expense {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id])
  categoryId    String
  category      ExpenseCategory      @relation(fields: [categoryId], references: [id])
  date          DateTime
  amount        Decimal              @db.Decimal(12, 2)
  currency      String
  description   String
  vendor        String?
  paymentMethod ExpensePaymentMethod @default(OTHER)
  paidBy        ExpensePaidBy        @default(COMPANY)
  userId        String
  user          User                 @relation("ExpenseOwner", fields: [userId], references: [id])
  submittedById String
  submittedBy   User                 @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  status        ExpenseStatus        @default(PENDING)
  source        ExpenseSource        @default(MANUAL)
  // Raw Azure Document Intelligence extraction for a captured receipt: per-field confidence scores,
  // line items, and the model/version used. Null for manually-entered expenses. Informational —
  // the authoritative values are the editable columns above (the user confirms/corrects them).
  captureData   Json?
  decidedById   String?
  decidedBy     User?                @relation("ExpenseDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  receipts ExpenseReceipt[]

  @@index([companyId, date])
  @@index([status])
  @@index([categoryId])
}

// A single receipt can be several files (e.g. a hotel folio + a taxi slip both covering one
// trip expense line) — stored on local disk under uploads/receipts (see src/lib/receipt-
// storage.ts), never in git. `fileName` is the on-disk name (randomized, unrelated to
// `originalName`) so two people's "receipt.jpg" never collide.
model ExpenseReceipt {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id])
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())

  @@index([expenseId])
}

// ---------- App settings ----------

// Global (app-wide, not company-scoped) key/value settings that must be readable BEFORE auth — e.g.
// the login page and the Credentials authorize() need to know whether password login is enabled.
// First key: "passwordLoginEnabled" ("true"/"false"). Toggled by an Admin at /admin/settings.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Opportunities (sales pipeline) ----------

// A sales opportunity / deal, worked by SALES/PM/Admin (opportunities:manage) through the
// OpportunityStage pipeline. Owner/actor/decider triad mirrors Expense/LeaveRequest/TimeCard:
// `owner` owns the deal, `submittedBy` submitted it for approval, `decidedBy` is the Admin who
// approved/rejected. On WON approval the deal converts to a Project (one Milestone per line) in a
// single transaction and `projectId` is stamped (see src/app/(app)/opportunities/actions.ts).
// Discount is deal-level (not baked into line unit prices): the lines carry list prices, and the
// net figure is computed from discountType/discountValue — that same discount is copied onto the
// created Project.
model Opportunity {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  contactId         String?
  contact           Contact?           @relation(fields: [contactId], references: [id])
  name              String
  // Free-text internal deal number / client RFQ or tender reference.
  reference         String?
  stage             OpportunityStage   @default(QUALIFYING)
  billingType       ProjectBillingType @default(TIME_AND_MATERIALS)
  currency          String
  expectedCloseDate DateTime?
  // 0-100 win likelihood, drives the weighted-pipeline forecast. Free-form judgement, not derived.
  probability       Int?

  // Deal-level discount off the list total (lines keep list unit prices).
  discountType      DiscountType?
  discountValue     Decimal?           @db.Decimal(12, 2)

  // owner / actor / decider triad
  ownerId           String
  owner             User               @relation("OpportunityOwner", fields: [ownerId], references: [id])
  submittedById     String?
  submittedBy       User?              @relation("OpportunitySubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  decidedById       String?
  decidedBy         User?              @relation("OpportunityDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  decisionComment   String?

  // SoW / PO contract metadata (all optional — PO is not required to approve).
  sowNumber         String?
  sowSignedDate     DateTime?
  poNumber          String?
  poAmount          Decimal?           @db.Decimal(12, 2)
  poDate            DateTime?

  lostReason        String?

  // Set once the opportunity is won and converted; unique so a deal maps to at most one project.
  projectId         String?            @unique
  project           Project?           @relation("OpportunityProject", fields: [projectId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lines      OpportunityLine[]
  revisions  OpportunityRevision[]
  amendments OpportunityAmendment[]
  documents  Document[]

  @@index([companyId, stage])
  @@index([clientId])
}

// One priced line of the current (live) quote. Becomes exactly one Milestone on conversion:
// `unitPrice` -> Milestone.salesPrice (list rate/hr for T&M/RETAINER, lump sum for FIXED_PRICE),
// `quantityHours` -> Milestone.budgetHours. Editable while the deal is open.
model OpportunityLine {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  name          String
  description   String?
  quantityHours Decimal     @db.Decimal(10, 2)
  unitPrice     Decimal     @db.Decimal(12, 4)
  billable      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([opportunityId])
}

// An immutable snapshot of the quote each time a proposal is "issued" to the client — the
// negotiation audit trail (v1 initial, v2 after discount, v3 reduced scope, ...). `linesSnapshot`
// is a JSON copy of the lines at issue time (name/quantityHours/unitPrice/billable) so later edits
// to live lines never mutate history. gross/discount/net are frozen at issue time.
model OpportunityRevision {
  id             String        @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id])
  version        Int
  label          String?
  linesSnapshot  Json
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  grossAmount    Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  note           String?
  issuedById     String
  issuedBy       User          @relation("OpportunityRevisionIssuedBy", fields: [issuedById], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([opportunityId, version])
  @@index([opportunityId])
}

// A contract amendment / change-order applied to an already-WON opportunity: additional hours
// (and value) agreed after the deal closed. Applying one appends milestone(s) to the linked
// project and bumps the project's contractValue / budgetHours / budgetAmount. Immutable once
// created — `linesSnapshot` is the JSON record of what was added ({name, quantityHours, unitPrice,
// billable, target}) and `addedHours`/`netAmount` freeze the totals. `version` numbers amendments
// per opportunity (1, 2, 3, ...).
model OpportunityAmendment {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  version       Int
  reference     String? // amendment / change-order reference (e.g. "AMD-2")
  poNumber      String? // customer PO covering the amendment, if any
  signedDate    DateTime?
  note          String?
  linesSnapshot Json
  addedHours    Decimal     @db.Decimal(10, 2)
  netAmount     Decimal     @db.Decimal(12, 2) // value added to the project's contract
  appliedById   String
  appliedBy     User        @relation("OpportunityAmendmentAppliedBy", fields: [appliedById], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, version])
  @@index([opportunityId])
  @@index([projectId])
}

// ---------- Documents (invoice / opportunity attachments) ----------

enum DocumentKind {
  FISCAL_INVOICE // the fiscal app's invoice PDF, attached at reconciliation
  CREDIT_NOTE // a customer credit-note document
  SOW // Statement of Work (opportunity)
  PO // Purchase Order (opportunity)
  OTHER
}

// A file attached to an Invoice OR an Opportunity (exactly one of invoiceId/opportunityId is set,
// enforced in the upload actions). Stored on local disk under uploads/documents (never in public/,
// served only through the authenticated src/app/api/documents/[fileName] route), mirroring how
// ExpenseReceipt handles expense files. `companyId` is denormalized so the serve route can
// tenant-scope without joining the parent.
model Document {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  kind          DocumentKind
  fileName      String // randomized on-disk name (uuid + ext)
  originalName  String
  mimeType      String
  sizeBytes     Int
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  uploadedAt    DateTime     @default(now())

  @@index([invoiceId])
  @@index([opportunityId])
  @@index([companyId])
}
