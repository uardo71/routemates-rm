# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# A scratch build directory (a build run with distDir pointed away from /.next). It must be ignored
# as well as unused: Tailwind's source detection scans whatever .gitignore does NOT cover, so an
# un-ignored build output gets read as source and its compiled chunks turn into garbage class
# candidates — which lands raw control characters in the generated CSS and breaks the parser.
/.next-verify/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# uploaded receipts (local filesystem storage, never committed)
/uploads

# database backups (pg_dump output — real data, transferred out-of-band, never committed)
/backups

# machine-local Claude Code state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
